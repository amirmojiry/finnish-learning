{
  "name": "finnish-learning",
  "version": "1.34.4",
  "private": true,
  "description": "A Persian-first Finnish vocabulary learning web application.",
  "scripts": {
    "test": "node scripts/check-version.cjs && node scripts/build-vocabulary.mjs --check && node scripts/sync-grammar-registry.cjs --check && node scripts/audit-course-coverage.cjs --check && node scripts/build-lexical-identity.cjs --check && node scripts/audit-lesson-composition.cjs --check && node scripts/plan-parole-expansion.cjs --check && node --test tests/*.test.cjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:js": "node --test tests/*.test.cjs",
    "test:data": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "build:vocabulary": "node scripts/build-vocabulary.mjs",
    "version:patch": "node scripts/bump-version.cjs patch",
    "version:minor": "node scripts/bump-version.cjs minor",
    "version:major": "node scripts/bump-version.cjs major",
    "sync": "python3 scripts/sync_project.py",
    "curriculum:check": "node scripts/audit-master-curriculum.cjs --check",
    "curriculum:audit": "node scripts/audit-master-curriculum.cjs --markdown",
    "curriculum:coverage:report": "node scripts/audit-course-coverage.cjs --markdown",
    "curriculum:coverage:json": "node scripts/audit-course-coverage.cjs --json",
    "curriculum:coverage:write": "node scripts/audit-course-coverage.cjs --write",
    "curriculum:coverage:check": "node scripts/audit-course-coverage.cjs --check",
    "lexical:identity:check": "node scripts/build-lexical-identity.cjs --check",
    "lexical:identity:write": "node scripts/build-lexical-identity.cjs --write",
    "lesson:composition:check": "node scripts/audit-lesson-composition.cjs --check",
    "lesson:composition:json": "node scripts/audit-lesson-composition.cjs --json",
    "lesson:composition:report": "node scripts/audit-lesson-composition.cjs --markdown",
    "lesson:composition:write": "node scripts/audit-lesson-composition.cjs --write",
    "parole:plan:check": "node scripts/plan-parole-expansion.cjs --check",
    "parole:plan:json": "node scripts/plan-parole-expansion.cjs --json",
    "parole:plan:markdown": "node scripts/plan-parole-expansion.cjs --markdown"
  },
  "engines": {
    "node": ">=20",
    "python": ">=3.12"
  }
}
